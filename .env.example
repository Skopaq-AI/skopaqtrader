# Copy to .env and fill in. docker compose's env_file treats `$` specially:
# write `$$` for a literal `$` in a value.

# ===== LLM Providers =====
# Upstream TradingAgents keys (set these OR the SKOPAQ_ variants below)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Skopaq-prefixed keys (bridged automatically to standard vars above)
SKOPAQ_GOOGLE_API_KEY=
SKOPAQ_ANTHROPIC_API_KEY=
SKOPAQ_XAI_API_KEY=
SKOPAQ_PERPLEXITY_API_KEY=
SKOPAQ_OPENROUTER_API_KEY=
# TypeSafe Jev — optional. The key alone turns on upstream's StockTwits/Reddit
# post screening; SKOPAQ_JEV_ENABLED=true also uses Jev for entry-signal
# confidence, the sell analyst's exit call and scanner catalyst scoring
# (skopaq/llm/jev.py).
SKOPAQ_TYPESAFE_API_KEY=
SKOPAQ_JEV_ENABLED=false
SKOPAQ_JEV_MODEL=jev-1.13.0
SKOPAQ_JEV_MIN_CONFIDENCE=0.6
# Jev through a gateway instead of api.typesafe.ai (no TypeSafe account): for
# OpenRouter set https://openrouter.ai/api, put your OpenRouter key in
# SKOPAQ_TYPESAFE_API_KEY and set SKOPAQ_JEV_MODEL=jev-1.13 (not confirmed to
# be the same build as jev-1.13.0: re-check SKOPAQ_JEV_MIN_CONFIDENCE on paper).
# Post screening uses it too. Empty = api.typesafe.ai.
SKOPAQ_JEV_BASE_URL=
# Scanner: Jev scores each candidate's reason 0-3 (0 generic, 1 price/volume
# only, 2 named cause, 3 major company event) and ranks by it. Candidates below
# this are dropped; 0 only ranks. Raise it once paper results support it.
SKOPAQ_JEV_MIN_CATALYST_SCORE=0

# ===== Supabase =====
SKOPAQ_SUPABASE_URL=https://your-project.supabase.co
SKOPAQ_SUPABASE_ANON_KEY=eyJ...
SKOPAQ_SUPABASE_SERVICE_KEY=eyJ...

# ===== Upstash Redis =====
SKOPAQ_UPSTASH_REDIS_URL=https://your-redis.upstash.io
SKOPAQ_UPSTASH_REDIS_TOKEN=AX...

# ===== INDstocks Broker =====
SKOPAQ_INDSTOCKS_TOKEN=
SKOPAQ_INDSTOCKS_BASE_URL=https://api.indstocks.com

# ===== Trading Mode =====
# paper = simulated trades, live = real money via INDstocks
SKOPAQ_TRADING_MODE=paper
# Kill switch at deploy level: true rejects every BUY (see `skopaq halt`)
SKOPAQ_TRADING_HALTED=false

# ===== Asset Class =====
# equity = Indian equities (NSE/BSE), crypto = Binance Spot
SKOPAQ_ASSET_CLASS=equity
SKOPAQ_CRYPTO_QUOTE_CURRENCY=USDT
SKOPAQ_BINANCE_BASE_URL=https://api.binance.com

# ===== Scanner =====
# Enable background scanner (30s cycle on NIFTY 50 watchlist)
SKOPAQ_SCANNER_ENABLED=false
SKOPAQ_SCANNER_CYCLE_SECONDS=30
SKOPAQ_SCANNER_MAX_CANDIDATES=5

# ===== Cloudflare Tunnel (inbound HTTPS for Kite callbacks; NOT a static outbound IP) =====
SKOPAQ_CF_TUNNEL_ID=

# ===== Semantic Cache (Redis LangCache) =====
SKOPAQ_LANGCACHE_ENABLED=false
SKOPAQ_LANGCACHE_API_KEY=
SKOPAQ_LANGCACHE_SERVER_URL=https://aws-ap-south-1.langcache.redis.io
SKOPAQ_LANGCACHE_CACHE_ID=
SKOPAQ_LANGCACHE_THRESHOLD=0.90

# ===== Frontend (Next.js) =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== Telegram Bot =====
# The bot answers only SKOPAQ_TELEGRAM_CHAT_ID and SKOPAQ_TELEGRAM_ALLOWED_CHAT_IDS
SKOPAQ_TELEGRAM_BOT_TOKEN=
SKOPAQ_TELEGRAM_CHAT_ID=
SKOPAQ_TELEGRAM_ALLOWED_CHAT_IDS=

# ===== Always-on host (docker compose: api + telegram + scheduler) =====
# docs/deployment/mac-mini.md. The scheduler runs one daemon session per NSE trading day.
# A mistyped SKOPAQ_SCHEDULER_* value stops just the scheduler (alerted once a day), never
# api or telegram.
SKOPAQ_SCHEDULER_ENABLED=true
# paper | live. live also needs SKOPAQ_SCHEDULER_CONFIRM_LIVE=true (real money); a value
# other than true/false (yes/no, on/off, 1/0) counts as not confirmed: no session, an alert.
SKOPAQ_SCHEDULER_MODE=paper
SKOPAQ_SCHEDULER_CONFIRM_LIVE=false
# IST times: first launch, catch-up window end, hard stop, nightly settle (empty = off)
SKOPAQ_SCHEDULER_START=09:15
SKOPAQ_SCHEDULER_LAST_START=11:30
SKOPAQ_SCHEDULER_DEADLINE=15:45
SKOPAQ_SCHEDULER_SETTLE_AT=18:30
# IST: Telegram alert if the INDstocks token is missing or expires before the session ends (empty = off)
SKOPAQ_SCHEDULER_PREFLIGHT=08:45
# Optional dead-man's switch (healthchecks.io style): URL on success, URL/fail on failure
SKOPAQ_SCHEDULER_PING_URL=
# Extra NSE closures, comma-separated YYYY-MM-DD; any date of a year also marks that year as known
SKOPAQ_NSE_HOLIDAYS=
# Ollama on the Mac host as seen from containers (compose maps it to SKOPAQ_OLLAMA_BASE_URL)
SKOPAQ_DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Your whitelisted static egress IPv4 (INDstocks); scripts/macmini/verify.sh compares it
SKOPAQ_EXPECTED_EGRESS_IP=

# ===== API access =====
# Public HTTPS URL of the API (Kite login links in Telegram), e.g. your Cloudflare Tunnel host
SKOPAQ_PUBLIC_BASE_URL=
# HTTP fallback for a process without the /data volume to fetch the Kite token. Leave it empty
# here: every compose container reads this file, and the api would call itself. For the native
# Claude Code MCP server on the Mac, set SKOPAQ_API_BASE_URL=http://127.0.0.1:8000 in the "env"
# block of .claude/.mcp.json instead (docs/deployment/mac-mini.md, section 13).
SKOPAQ_API_BASE_URL=
# When set, /api/chat/* and /api/kite/token require 'Authorization: Bearer <token>'
SKOPAQ_API_TOKEN=
# Browser origins allowed to call the API (comma-separated); '*' allows any site
SKOPAQ_CORS_ORIGINS=http://localhost:3000
